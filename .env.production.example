# ---------------------------------------------------------------------------
# Mubarak Boardinghouse - PRODUCTION .env (shared web hosting / cPanel)
# Copy to the server as ".env", fill in every <...>, then run:
#   php artisan key:generate --force
#   php artisan migrate --force
#   php artisan storage:link
#   php artisan config:cache && php artisan route:cache && php artisan view:cache
# Never commit the real .env.
# ---------------------------------------------------------------------------

APP_NAME="Mubarak Boardinghouse"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Manila
APP_URL=https://<your-domain.com>

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Daily log files in storage/logs, kept 14 days. Only errors in production.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# cPanel usually prefixes names with your account: e.g. cpuser_mubarak / cpuser_admin
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<cpuser_mubarak>
DB_USERNAME=<cpuser_dbuser>
DB_PASSWORD=<strong-database-password>

# HTTPS only: cookies are never sent over plain http.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# No always-on worker on shared hosting: jobs (statement emails) wait in the database
# and the cron job below runs them every minute.
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=mubarak_

# Your hosting's mailbox (cPanel > Email Accounts > Connect Devices shows these values).
MAIL_MAILER=smtp
MAIL_ENCRYPTION=ssl
MAIL_HOST=mail.<your-domain.com>
MAIL_PORT=465
MAIL_USERNAME=billing@<your-domain.com>
MAIL_PASSWORD=<mailbox-password>
MAIL_FROM_ADDRESS="billing@<your-domain.com>"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Only used if you ever run "php artisan db:seed" on the server. Leave seeding off in production.
SEED_PASSWORD=<long-random-password>

# --- PDFs -------------------------------------------------------------------
# "Print all statements" on the Bills screen needs NO PDF engine (the browser prints / saves as PDF).
# Single statement PDFs, emailed statements and reports need one of these:
#  A) Hosting that allows Chrome (VPS, or a host with Node + Chrome): keep browsershot and set the paths.
LARAVEL_PDF_DRIVER=browsershot
PDF_CHROME_PATH=/usr/bin/google-chrome
LARAVEL_PDF_NODE_BINARY=/usr/bin/node
LARAVEL_PDF_NPM_BINARY=/usr/bin/npm
LARAVEL_PDF_NO_SANDBOX=true
#  B) Plain shared hosting (no Chrome): use Cloudflare Browser Rendering instead (free tier available).
# LARAVEL_PDF_DRIVER=cloudflare
# CLOUDFLARE_API_TOKEN=<token-with-Browser-Rendering-permission>
# CLOUDFLARE_ACCOUNT_ID=<cloudflare-account-id>

# ---------------------------------------------------------------------------
# cPanel > Cron Jobs (every minute). Replace /home/<cpuser>/mubarak with your app folder:
#   * * * * * cd /home/<cpuser>/mubarak && php artisan schedule:run >> /dev/null 2>&1
#   * * * * * cd /home/<cpuser>/mubarak && php artisan queue:work --stop-when-empty --max-time=50 >> /dev/null 2>&1
# Point the domain's document root to /home/<cpuser>/mubarak/public (never the project root).
# ---------------------------------------------------------------------------
